---
import Base from '../layouts/Base.astro';
import DrugArticle from '../components/DrugArticle.astro';
import PrincipleArticle from '../components/PrincipleArticle.astro';
import {
  buildWikiPatterns,
  getDrugs,
  getPrinciples,
  drugCategories,
} from '../lib/entries';
import { renderWiki, splitPrincipleIntro } from '../lib/markdown';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const [drugs, principles] = await Promise.all([getDrugs(), getPrinciples()]);

  // 扁平命名空间：药物与原理共用 /{id}，构建期校验唯一性
  const seen = new Map<string, string>();
  for (const d of drugs) {
    const id = d.data.id;
    if (seen.has(id)) throw new Error(`词条 ID 冲突：${id}（${seen.get(id)} 与 ${d.filePath}）`);
    seen.set(id, 'drug');
  }
  for (const p of principles) {
    const id = p.data.id;
    if (seen.has(id)) throw new Error(`词条 ID 冲突：${id}（${seen.get(id)} 与 ${p.filePath}）`);
    seen.set(id, 'principle');
  }

  return [
    ...drugs.map((entry) => ({ params: { id: entry.data.id }, props: { kind: 'drug' as const, entry } })),
    ...principles.map((entry) => ({
      params: { id: entry.data.id },
      props: { kind: 'principle' as const, entry },
    })),
  ];
}

const { kind, entry } = Astro.props as {
  kind: 'drug' | 'principle';
  entry: CollectionEntry<'drugs'> | CollectionEntry<'principles'>;
};

const principles = await getPrinciples();
const patterns = buildWikiPatterns(principles);

let title: string;
let description: string;
let article: { html: string; toc: import('../lib/types').TocItem[] };
let introHtml = '';

if (kind === 'drug') {
  const drug = entry as CollectionEntry<'drugs'>;
  title = `${drug.data.name_cn} ${drug.data.name_en} — PsychPedia`;
  description = `${drug.data.name_cn}（${drug.data.name_en}）：${drugCategories(drug).join('、')}。${
    drug.data.tags.slice(0, 4).join('、') || '作用机制、药代动力学与临床用药速查'
  }。`;
  article = await renderWiki(drug.body ?? '', patterns);
} else {
  const principle = entry as CollectionEntry<'principles'>;
  title = `${principle.data.title}${principle.data.subtitle ? ` ${principle.data.subtitle}` : ''} — PsychPedia`;
  description =
    principle.data.description ?? `${principle.data.title}：受体药理学特性、临床相关性与词条速查。`;
  const { intro, rest } = splitPrincipleIntro(principle.body ?? '');
  const introWiki = intro ? await renderWiki(intro, patterns) : null;
  introHtml = introWiki?.html ?? '';
  article = await renderWiki(rest, patterns);
}
---

<Base title={title} description={description} toc={article.toc} showWidthToggle>
  {
    kind === 'drug' ? (
      <DrugArticle
        entry={entry as CollectionEntry<'drugs'>}
        wiki={article}
        patterns={patterns}
      />
    ) : (
      <PrincipleArticle
        entry={entry as CollectionEntry<'principles'>}
        wiki={article}
        introHtml={introHtml}
      />
    )
  }
</Base>
